---
import BaseLayout from '../layouts/BaseLayout.astro';

interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  title: string;
  seoTitle: string;
  description: string;
  eyebrow: string;
  hero: string;
  problems: string[];
  scopes: { title: string; description: string }[];
  checks: string[];
  examples: string[];
  technologies: string[];
  faq: FaqItem[];
  relatedServiceHref: string;
  relatedServiceLabel: string;
}

const {
  title,
  seoTitle,
  description,
  eyebrow,
  hero,
  problems,
  scopes,
  checks,
  examples,
  technologies,
  faq,
  relatedServiceHref,
  relatedServiceLabel,
} = Astro.props;

const pageUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : Astro.url.toString();
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: title,
    serviceType: title,
    description,
    url: pageUrl,
    areaServed: 'JP',
    provider: {
      '@type': 'ProfessionalService',
      name: 'TI AUTOMATION STUDIO',
      url: Astro.site?.toString() ?? '/',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'トップ', item: Astro.site?.toString() ?? '/' },
      { '@type': 'ListItem', position: 2, name: 'できること', item: Astro.site ? new URL('/services', Astro.site).toString() : '/services' },
      { '@type': 'ListItem', position: 3, name: title, item: pageUrl },
    ],
  },
];
---
<BaseLayout title={seoTitle} description={description} structuredData={structuredData}>
  <section class="service-hero">
    <div class="container service-hero-grid reveal">
      <div class="service-hero-copy">
        <nav class="breadcrumb" aria-label="パンくずリスト">
          <a href="/">トップ</a><span>／</span><a href="/services">できること</a><span>／</span><span>{title}</span>
        </nav>
        <p class="eyebrow">{eyebrow}</p>
        <h1>{title}</h1>
        <p class="service-hero-lead">{hero}</p>
        <p class="service-hero-description">{description}</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/contact">修正内容を相談する →</a>
          <a class="btn" href="/price">料金の目安を見る →</a>
        </div>
      </div>
      <aside class="service-visual" aria-label="修正対応の進め方">
        <div class="repair-visual-card">
          <span>REPAIR FLOW</span>
          <strong>現状確認 → 原因特定 → 修正 → 再テスト</strong>
          <p>いきなり作り直さず、まず既存ファイル・コード・運用を確認してから、修正範囲を整理します。</p>
        </div>
      </aside>
    </div>
  </section>

  <section class="section service-problems">
    <div class="container service-section-grid">
      <div><p class="eyebrow">COMMON PROBLEMS</p><h2 class="section-title">こんな状態から相談できます。</h2></div>
      <div class="service-check-list">
        {problems.map((problem) => <div class="service-check-item"><span aria-hidden="true">—</span><p>{problem}</p></div>)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">WHAT WE REPAIR</p>
      <h2 class="section-title">修正・改修できること</h2>
      <div class="service-capability-grid">
        {scopes.map((scope, index) => (
          <article class="service-capability-card">
            <span>{String(index + 1).padStart(2, '0')}</span>
            <h3>{scope.title}</h3>
            <p>{scope.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container service-section-grid">
      <div><p class="eyebrow">FIRST CHECK</p><h2 class="section-title">最初に確認するポイント</h2><p class="section-lead">不具合だけを直して別の箇所が壊れないよう、影響範囲を先に確認します。</p></div>
      <ol class="service-example-list">
        {checks.map((check, index) => <li><span>{String(index + 1).padStart(2, '0')}</span><p>{check}</p></li>)}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container service-section-grid">
      <div><p class="eyebrow">EXAMPLES</p><h2 class="section-title">よくある修正例</h2></div>
      <ol class="service-example-list">
        {examples.map((example, index) => <li><span>{String(index + 1).padStart(2, '0')}</span><p>{example}</p></li>)}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container service-section-grid">
      <div>
        <p class="eyebrow">TECHNOLOGY</p>
        <h2 class="section-title">既存環境をできるだけ活かします。</h2>
        <div class="tags service-tech-tags">{technologies.map((tech) => <span class="tag">{tech}</span>)}</div>
      </div>
      <div>
        <p class="eyebrow">RELATED</p>
        <div class="service-related-links"><a href={relatedServiceHref}><span>{relatedServiceLabel}</span><span aria-hidden="true">→</span></a></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container service-faq">
      <div><p class="eyebrow">FAQ</p><h2 class="section-title">よくある質問</h2></div>
      <div class="service-faq-list">
        {faq.map((item) => <details><summary>{item.question}<span aria-hidden="true">＋</span></summary><p>{item.answer}</p></details>)}
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="container cta-band-inner">
      <div><p class="eyebrow">CONTACT</p><h2>動かない理由が分からない段階でも、<br />現状から整理できます。</h2></div>
      <a class="btn btn-primary" href="/contact">修正内容を送る →</a>
    </div>
  </section>
</BaseLayout>

<style>
  .repair-visual-card {
    min-height: 320px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 14px;
    padding: 32px;
    border: 1px solid var(--line);
    border-radius: 20px;
    background: linear-gradient(145deg, rgba(200, 169, 107, .12), rgba(255, 255, 255, .02));
  }
  .repair-visual-card span { color: var(--accent); font-size: .78rem; letter-spacing: .16em; }
  .repair-visual-card strong { font-size: clamp(1.25rem, 2.3vw, 1.8rem); line-height: 1.5; }
  .repair-visual-card p { margin: 0; color: var(--muted); line-height: 1.9; }
</style>
