---
import '../styles/global.css';
import '../styles/services.css';
import '../styles/about.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, canonical, ogImage, structuredData } = Astro.props;
const pageTitle = title === 'TI AUTOMATION STUDIO' ? title : `${title} | TI AUTOMATION STUDIO`;
const canonicalUrl = canonical ?? (Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : Astro.url.toString());
const resolveAssetUrl = (value: string) => Astro.site ? new URL(value, Astro.site).toString() : value;
const ogImageUrl = resolveAssetUrl(ogImage ?? '/og-default.svg');
const siteUrl = Astro.site?.toString() ?? canonicalUrl;
const sharedStructuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'TI AUTOMATION STUDIO',
    url: siteUrl,
    inLanguage: 'ja-JP',
    description: 'Excel・GAS・Python・Web・API・AIを活用した業務改善・自動化開発。',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    name: 'TI AUTOMATION STUDIO',
    description: 'Excel・GAS・Python・Web・API・AIを活用した業務改善・自動化開発。',
    url: siteUrl,
    areaServed: 'JP',
    knowsAbout: ['業務自動化', 'Excel', 'Google Apps Script', 'Python', 'Webシステム', 'API連携', 'AI活用'],
  },
];
const pageStructuredData = structuredData ? (Array.isArray(structuredData) ? structuredData : [structuredData]) : [];
const structuredDataItems = [...sharedStructuredData, ...pageStructuredData];
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#0B0C0E" />
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="R2F-nSTc4w9KY3PCBI2bGG6TvsgPLMwXYng-q31bG3g" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:site_name" content="TI AUTOMATION STUDIO" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    {structuredDataItems.map((item) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(item)}></script>
    ))}
  </head>
  <body>
    <header class="site-header">
      <div class="container nav">
        <a class="brand" href="/" aria-label="TI AUTOMATION STUDIO トップへ">
          <span class="brand-mark" aria-hidden="true"></span>
          <span>TI AUTOMATION STUDIO</span>
        </a>
        <nav class="nav-links" aria-label="メインナビゲーション">
          <a href="/services">できること</a>
          <a href="/works">実績</a>
          <a href="/tools">公開ツール</a>
          <a href="/about">制作者</a>
          <a href="/#process">開発の流れ</a>
          <span class="nav-actions">
            <a class="nav-cta nav-site-cta" href="/contact" aria-label="サイトから相談する">
              <span class="nav-label-desktop">サイトから相談</span>
              <span class="nav-label-mobile">相談</span>
            </a>
            <a
              class="nav-cta nav-coconala-cta"
              href="https://coconala.com/users/5379632"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="ココナラから問い合わせる"
            >
              <span class="nav-label-desktop">ココナラから問い合わせ</span>
              <span class="nav-label-mobile">ココナラ</span>
              <span aria-hidden="true">↗</span>
            </a>
          </span>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-inner">
        <span>© 2026 TI AUTOMATION STUDIO</span>
        <div class="footer-links">
          <a href="/services">できること</a>
          <a href="/works">実績</a>
          <a href="/about">制作者</a>
          <a href="/privacy">プライバシーポリシー</a>
          <a href="https://github.com/TI-06" target="_blank" rel="noopener noreferrer">GitHub</a>
        </div>
      </div>
    </footer>
    <style>
      .nav-actions {
        display: inline-flex;
        align-items: center;
        gap: 8px;
      }

      .nav-coconala-cta {
        border-color: var(--accent);
        background: rgba(200, 169, 107, .1);
      }

      .nav-coconala-cta:hover {
        background: rgba(200, 169, 107, .18);
      }

      .nav-label-mobile {
        display: none;
      }

      @media (max-width: 1120px) {
        .nav-links {
          gap: 18px;
        }

        .nav-actions {
          gap: 6px;
        }

        .nav-actions .nav-cta {
          padding-inline: 11px;
        }
      }

      @media (max-width: 560px) {
        .nav {
          gap: 10px;
        }

        .nav-actions {
          gap: 5px;
        }

        .nav-actions .nav-cta {
          padding: 7px 8px;
          font-size: .7rem;
          white-space: nowrap;
        }

        .nav-label-desktop {
          display: none;
        }

        .nav-label-mobile {
          display: inline;
        }
      }
    </style>
    <script>
      if (document.querySelector('[data-dashboard-app]')) {
        void import('../scripts/tools/dashboard-builder');
      }
    </script>
  </body>
</html>