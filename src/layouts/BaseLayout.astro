---
import '../styles/global.css';
import '../styles/services.css';
import '../styles/about.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const { title, description, canonical, ogImage, structuredData, noindex = false } = Astro.props;
const pageTitle = title === 'TI AUTOMATION STUDIO' ? title : `${title} | TI AUTOMATION STUDIO`;
const canonicalUrl = canonical ?? (Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : Astro.url.toString());
const resolveAssetUrl = (value: string) => Astro.site ? new URL(value, Astro.site).toString() : value;
const ogImageUrl = resolveAssetUrl(ogImage ?? '/og-default.svg');
const siteUrl = Astro.site?.toString() ?? canonicalUrl;
const sharedStructuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'TI AUTOMATION STUDIO',
    url: siteUrl,
    inLanguage: 'ja-JP',
    description: 'Excel・GAS・Python・Web・API・AIを活用した業務改善・自動化開発。',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    name: 'TI AUTOMATION STUDIO',
    description: 'Excel・GAS・Python・Web・API・AIを活用した業務改善・自動化開発。',
    url: siteUrl,
    logo: resolveAssetUrl('/favicon.svg'),
    image: ogImageUrl,
    areaServed: 'JP',
    knowsAbout: ['業務自動化', 'Excel', 'Google Apps Script', 'Python', 'Webシステム', 'API連携', 'AI活用'],
  },
];
const pageStructuredData = structuredData ? (Array.isArray(structuredData) ? structuredData : [structuredData]) : [];
const structuredDataItems = [...sharedStructuredData, ...pageStructuredData];
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#0B0C0E" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow'} />
    <meta name="google-site-verification" content="R2F-nSTc4w9KY3PCBI2bGG6TvsgPLMwXYng-q31bG3g" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:site_name" content="TI AUTOMATION STUDIO" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    {structuredDataItems.map((item) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(item)}></script>
    ))}
  </head>
  <body>
    <header class="site-header">
      <div class="container nav">
        <a class="brand" href="/" aria-label="TI AUTOMATION STUDIO トップへ">
          <span class="brand-mark" aria-hidden="true"></span>
          <span class="brand-full">TI AUTOMATION STUDIO</span><span class="brand-compact">TI STUDIO</span>
        </a>
        <nav class="nav-links" aria-label="メインナビゲーション">
          <a href="/services">サービス</a>
          <a href="/works">実績</a>
          <a href="/price">料金</a>
          <a href="/solutions">自動化ガイド</a>
          <a href="/tools">無料ツール</a>
          <a href="/about">制作者</a>
          <span class="nav-actions">
            <a class="nav-cta nav-site-cta" href="/contact" >
              <span class="nav-label-desktop">相談する</span>
              <span class="nav-label-mobile">相談</span>
            </a>
            <a
              class="nav-cta nav-coconala-cta"
              href="https://coconala.com/users/5379632"
              target="_blank"
              rel="noopener noreferrer"
              
            >
              <span class="nav-label-desktop">ココナラ</span>
              <span class="nav-label-mobile">ココナラ</span>
              <span aria-hidden="true">↗</span>
            </a>
          </span>
        </nav>
        <details class="mobile-menu" data-mobile-menu>
          <summary aria-label="メニューを開く"><span aria-hidden="true" class="mobile-menu-icon"><i></i><i></i><i></i></span><span class="mobile-menu-label">メニュー</span></summary>
          <nav class="mobile-menu-panel" aria-label="スマホ用メニュー">
            <a href="/services">サービス <span aria-hidden="true">→</span></a>
            <a href="/works">開発実績 <span aria-hidden="true">→</span></a>
            <a href="/price">料金 <span aria-hidden="true">→</span></a>
            <a href="/tools">無料ツール <span aria-hidden="true">→</span></a>
            <a href="/solutions">自動化ガイド <span aria-hidden="true">→</span></a>
            <a href="/about">制作者について <span aria-hidden="true">→</span></a>
            <a href="https://coconala.com/users/5379632" target="_blank" rel="noopener noreferrer">ココナラで相談 <span aria-hidden="true">↗</span></a>
            <a class="mobile-menu-primary" href="/contact">お問い合わせ・無料相談 <span aria-hidden="true">→</span></a>
          </nav>
        </details>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-inner">
        <span>© 2026 TI AUTOMATION STUDIO</span>
        <div class="footer-links">
          <a href="/services">サービス</a>
          <a href="/works">実績</a>
          <a href="/solutions">業務自動化ガイド</a>
          <a href="/tools">無料ツール</a>
          <a href="/price">料金</a>
          <a href="/about">制作者</a>
          <a href="/privacy">プライバシーポリシー</a>
          <a href="https://github.com/TI-06" target="_blank" rel="noopener noreferrer">GitHub</a>
        </div>
      </div>
    </footer>
    <style>
      .brand-compact, .mobile-menu { display: none; }
      @media (max-width: 860px) {
        .nav { position: relative; gap: 14px; }
        .nav-links { margin-left: auto; }
        .nav-actions .nav-coconala-cta { display: none; }
        .mobile-menu { display: block; flex: 0 0 auto; }
        .mobile-menu summary {
          display: inline-flex;
          align-items: center;
          justify-content: center;
          gap: 9px;
          min-width: 48px;
          min-height: 44px;
          padding: 8px 10px;
          border: 1px solid var(--border);
          color: var(--text);
          cursor: pointer;
          list-style: none;
          font-size: .75rem;
        }
        .mobile-menu summary::-webkit-details-marker { display: none; }
        .mobile-menu summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
        .mobile-menu-icon { display: grid; gap: 4px; }
        .mobile-menu-icon i { display: block; width: 18px; height: 2px; background: var(--text); transition: transform .2s ease; }
        .mobile-menu[open] .mobile-menu-icon i:first-child { transform: translateY(6px) rotate(45deg); }
        .mobile-menu[open] .mobile-menu-icon i:nth-child(2) { opacity: 0; }
        .mobile-menu[open] .mobile-menu-icon i:last-child { transform: translateY(-6px) rotate(-45deg); }
        .mobile-menu-panel {
          position: absolute;
          z-index: 60;
          top: calc(100% + 1px);
          right: 0;
          left: 0;
          display: grid;
          grid-template-columns: repeat(2, minmax(0, 1fr));
          gap: 8px;
          max-height: calc(100dvh - 84px);
          overflow-y: auto;
          padding: 18px;
          border: 1px solid var(--border-strong);
          background: #111317;
          box-shadow: var(--shadow);
        }
        .mobile-menu-panel a {
          min-width: 0;
          min-height: 48px;
          display: flex;
          align-items: center;
          justify-content: space-between;
          gap: 12px;
          padding: 12px;
          border: 1px solid var(--border);
          color: var(--text);
          line-height: 1.4;
          font-size: .85rem;
        }
        .mobile-menu-panel a span { color: var(--accent); }
        .mobile-menu-panel .mobile-menu-primary {
          grid-column: 1 / -1;
          background: var(--accent);
          border-color: var(--accent);
          color: var(--bg);
          font-weight: 700;
        }
        .mobile-menu-panel .mobile-menu-primary span { color: var(--bg); }
      }
      @media (max-width: 560px) {
        .brand-full { display: none; }
        .brand-compact { display: inline; }
        .mobile-menu-label { display: none; }
        .mobile-menu-panel { grid-template-columns: 1fr; }
        .mobile-menu-panel .mobile-menu-primary { grid-column: auto; }
      }
      .nav-actions {
        display: inline-flex;
        align-items: center;
        gap: 8px;
      }

      .nav-coconala-cta {
        border-color: var(--accent);
        background: rgba(200, 169, 107, .1);
      }

      .nav-coconala-cta:hover {
        background: rgba(200, 169, 107, .18);
      }

      .nav-label-mobile {
        display: none;
      }

      @media (max-width: 1120px) {
        .nav-links {
          gap: 18px;
        }

        .nav-actions {
          gap: 6px;
        }

        .nav-actions .nav-cta {
          padding-inline: 11px;
        }
      }

      @media (max-width: 560px) {
        .nav {
          gap: 10px;
        }

        .nav-actions {
          gap: 5px;
        }

        .nav-actions .nav-cta {
          padding: 7px 8px;
          font-size: .7rem;
          white-space: nowrap;
        }

        .nav-label-desktop {
          display: none;
        }

        .nav-label-mobile {
          display: inline;
        }
      }
    </style>
    <script>
      const mobileMenu = document.querySelector<HTMLDetailsElement>('[data-mobile-menu]');
      if (mobileMenu) {
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && mobileMenu.open) {
            mobileMenu.open = false;
            mobileMenu.querySelector<HTMLElement>('summary')?.focus();
          }
        });
        document.addEventListener('click', (event) => {
          if (mobileMenu.open && event.target instanceof Node && !mobileMenu.contains(event.target)) {
            mobileMenu.open = false;
          }
        });
        window.matchMedia('(min-width: 861px)').addEventListener('change', (event) => {
          if (event.matches) mobileMenu.open = false;
        });
      }
    </script>
    <script>
      if (document.querySelector('[data-dashboard-app]')) {
        void import('../scripts/tools/dashboard-builder');
      }
    </script>
  </body>
</html>