---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
}

const { title, description, canonical } = Astro.props;
const pageTitle = title === 'TI AUTOMATION STUDIO' ? title : `${title} | TI AUTOMATION STUDIO`;
const canonicalUrl = canonical ?? (Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : Astro.url.toString());
const ogImage = Astro.site ? new URL('/og-default.svg', Astro.site).toString() : '/og-default.svg';
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'TI AUTOMATION STUDIO',
  description: 'Excel・GAS・Python・Web・API・AIを活用した業務改善・自動化開発。',
  url: Astro.site?.toString() ?? canonicalUrl,
  areaServed: 'JP',
  knowsAbout: ['業務自動化', 'Excel', 'Google Apps Script', 'Python', 'Webシステム', 'API連携', 'AI活用'],
};
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#0B0C0E" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <header class="site-header">
      <div class="container nav">
        <a class="brand" href="/" aria-label="TI AUTOMATION STUDIO トップへ">
          <span class="brand-mark" aria-hidden="true"></span>
          <span>TI AUTOMATION STUDIO</span>
        </a>
        <nav class="nav-links" aria-label="メインナビゲーション">
          <a href="/#services">できること</a>
          <a href="/works">実績</a>
          <a href="/tools">公開ツール</a>
          <a href="/#process">開発の流れ</a>
          <a class="nav-cta" href="/contact">問い合わせ</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-inner">
        <span>© 2026 TI AUTOMATION STUDIO</span>
        <div class="footer-links">
          <a href="/privacy">プライバシーポリシー</a>
          <a href="https://github.com/TI-06" target="_blank" rel="noopener noreferrer">GitHub</a>
        </div>
      </div>
    </footer>
  </body>
</html>
