---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { works } from '../../data/works';

const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'TI AUTOMATION STUDIO 開発実績',
  itemListElement: works.map((work, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: work.title,
    url: Astro.site ? new URL(`/works/${work.slug}`, Astro.site).toString() : `/works/${work.slug}`,
  })),
};
---
<BaseLayout
  title="開発実績"
  description="Excel・GAS・Python・Web・APIを使った業務改善・自動化の開発実績。顧客情報を伏せ、課題と改善内容を紹介します。"
  structuredData={itemList}
>
  <section class="page-hero works-hero">
    <div class="container reveal">
      <p class="eyebrow">開発実績</p>
      <h1>業務の課題を、<br />動く仕組みへ。</h1>
      <p>「何を作ったか」だけではなく、もともと何に困っていて、どのように整理し、何が改善されたのかまで分かる形で紹介しています。</p>
    </div>
  </section>

  <section class="section-tight">
    <div class="container card-grid works-grid">
      {works.map((work, index) => (
        <a class="work-card work-card-detailed" href={`/works/${work.slug}`}>
          <div>
            <div class="work-card-topline">
              <span class="card-kicker">CASE {String(index + 1).padStart(2, '0')}</span>
              <span class="work-card-category">{work.category}</span>
            </div>
            <h2 class="card-title">{work.title}</h2>
            <p class="card-copy">{work.summary}</p>

            <div class="work-card-insights">
              <div class="work-card-insight">
                <span>課題</span>
                <p>{work.problem}</p>
              </div>
              <div class="work-card-insight">
                <span>改善</span>
                <p>{work.impact[0]}</p>
              </div>
            </div>
          </div>

          <div class="work-card-footer">
            <div class="tags">{work.technologies.slice(0, 4).map((tech) => <span class="tag">{tech}</span>)}</div>
            <span class="work-card-link">詳細を見る <span aria-hidden="true">→</span></span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="cta-band">
    <div class="container cta-band-inner">
      <div><p class="eyebrow">相談</p><h2>似た業務で困っているなら、<br />現在の運用から整理できます。</h2></div>
      <a class="btn btn-primary" href="/contact">開発について相談する →</a>
    </div>
  </section>
</BaseLayout>
