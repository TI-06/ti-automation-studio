---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/about-rework.css';

const personStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'TI AUTOMATION STUDIO 制作者',
  jobTitle: 'システムエンジニア',
  description: '現役SEとして約10年、本業で業務システム開発・改修に携わりながら、Excel・GAS・Python・Web・APIを活用した個別開発と業務改善にも取り組んでいます。',
  knowsAbout: ['業務自動化', 'Excel', 'VBA', 'Google Apps Script', 'Python', 'Webシステム', 'API連携', 'AI活用'],
  url: Astro.site ? new URL('/about', Astro.site).toString() : Astro.url.toString(),
};

const experienceSteps = [
  ['01', 'Excel・VBA', '日々の集計、転記、帳票作成、入力支援など、現場に近い業務改善から経験を重ねてきました。'],
  ['02', 'GAS・Google Workspace', 'スプレッドシートだけで完結しない業務に対して、DriveやGmailなどをつなぎ、複数人で使える仕組みへ広げてきました。'],
  ['03', 'Python・Web・API', '大量データ処理、専用の管理画面、外部サービス連携など、ExcelやGASだけでは扱いにくい要件にも対応範囲を広げています。'],
  ['04', 'AIを含む業務設計', 'AIありきではなく、分類・要約・入力補助など、実務の中で効果が出る部分だけに組み込む形で活用しています。'],
];

const painPoints = [
  ['転記・集計', '複数ファイルやシートへの転記、月次集計、定型計算など、繰り返し発生する手作業。'],
  ['帳票・PDF', 'Excelや入力データから、決まった形式の帳票・PDFを作成、保存、印刷する作業。'],
  ['複数人運用', '誰がどこまで作業したか分からない、同じファイルを触って競合する、担当者ごとに運用が違うといった課題。'],
  ['既存Excelの改修', '長く使っているExcelやVBAを捨てずに、入力・処理・画面を少しずつ改善したいケース。'],
  ['管理画面・Web化', 'Excelでは見づらくなった情報を、ブラウザで検索・確認・更新できる専用画面にまとめたいケース。'],
  ['API・サービス連携', '外部サービス間のデータ取得・登録・認証など、人が行っている受け渡しを自動化したいケース。'],
];

const specialties = [
  ['01', 'Pythonを使った業務自動化', 'CSV・Excelの整形や集計、大量データ処理、定型処理の自動実行など、繰り返し作業を安定して減らす開発。'],
  ['02', 'Google Apps Scriptを使った業務自動化', 'スプレッドシート、Drive、Gmail、フォームなど、今使っているGoogle Workspaceをつないで仕組みにする開発。'],
  ['03', '小規模なWebシステム', '大規模な基幹システムではなく、現場で必要な機能に絞った管理画面や業務用Webアプリの開発。'],
];

const capabilities = [
  ['01', 'Excel・VBA・スプレッドシート', '集計、転記、帳票作成、入力支援など、日々繰り返している作業を減らします。'],
  ['02', 'Google Apps Script', 'スプレッドシート、Drive、Gmailなどをつなぎ、Google Workspace上の業務を仕組み化します。'],
  ['03', 'Python・データ処理', 'CSV・Excelの整形、検証、変換、集計など、大量データの処理を効率化します。'],
  ['04', 'Web・API連携', 'ブラウザで使う業務画面や、外部サービスとのデータ連携・認証処理を構築します。'],
  ['05', 'PDF・帳票自動化', '定型帳票やPDFの生成、保存、出力までを業務フローに合わせて自動化します。'],
  ['06', 'AIを使った業務効率化', 'AIを使うこと自体を目的にせず、分類・要約・入力支援など実務で使える形に落とし込みます。'],
];

const consultationFits = [
  ['Excelが限界', 'シートや関数が増えすぎた、ファイルが重い、複数人運用が難しくなってきた。'],
  ['毎月同じ作業', '毎週・毎月、同じ転記や集計、ファイル作成を繰り返していて時間がかかっている。'],
  ['既存ツールを捨てたくない', '現在のExcelやGoogle Workspaceを活かしながら、必要な部分だけ改善したい。'],
  ['仕様が固まっていない', 'やりたいことはあるが、Excel・GAS・Webのどれで作るべきか分からない段階から相談したい。'],
];

const principles = [
  ['01', '現場で迷わないこと', '機能を増やすより、利用する人が次に何をすればいいか分かる画面と動線を優先します。'],
  ['02', '処理状態が分かること', '時間のかかる処理でも、動いているのか止まっているのか分からない状態をできるだけ作りません。'],
  ['03', '既存環境を活かすこと', 'ExcelやGoogle Workspaceなど、すでに使っている環境を捨てずに改善できるなら、その方法を優先します。'],
  ['04', '保守性まで考えること', 'その場で動くだけではなく、修正しやすさ、運用しやすさ、例外時の扱いまで考えて設計します。'],
];

const workflow = [
  ['01', '業務を整理する', 'いきなり作り始めず、現在の手順・利用者・入力データ・困っている箇所を整理します。'],
  ['02', '自動化する範囲を決める', '全部を自動化するのではなく、どこを自動化し、どこを人に残すかを決めます。'],
  ['03', '小さく確認しながら作る', '画面や主要処理を確認できる単位で実装し、完成後に大きな認識違いが出ないように進めます。'],
  ['04', '運用まで確認する', 'エラー時の動き、処理状態の表示、保守性、データの扱いまで含め、実際の利用を想定して仕上げます。'],
];
---
<BaseLayout
  title="制作者について"
  description="TI AUTOMATION STUDIOの制作者プロフィール。現役SEとして約10年、Excel・GAS・Python・Web・APIを使った業務改善と、使い続けられる小さなシステム開発に取り組んでいます。"
  structuredData={personStructuredData}
>
  <section class="page-hero about-page-hero">
    <div class="container reveal">
      <p class="eyebrow">制作者について</p>
      <h1>機能を増やすより、<br />仕事がちゃんと軽くなる仕組みを。</h1>
      <p>30代の現役SEとして、本業では業務システムの開発・改修に携わりながら、個人でも業務改善・自動化の開発を続けています。何を作るかより先に、「今の仕事のどこを変えると一番楽になるか」を考えることを大切にしています。</p>
      <div class="about-hero-meta" aria-label="制作者概要">
        <span>現役SE / 約10年</span>
        <span>個別開発・業務改善 約100件</span>
        <span>Python / GAS / Web</span>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container about-profile-grid">
      <aside class="about-profile-summary" aria-label="プロフィール概要">
        <div><span>経験</span><strong>システム開発 約10年</strong></div>
        <div><span>個別対応</span><strong>開発・業務改善 約100件</strong></div>
        <div><span>主な領域</span><strong>Excel / GAS / Python / Web / API</strong></div>
        <div><span>これから</span><strong>小規模Web・長期保守</strong></div>
      </aside>

      <div class="about-story">
        <p class="eyebrow">原点</p>
        <h2 class="section-title">システムで、<br />人の手作業が消える瞬間が好きです。</h2>
        <p>システム開発そのものに興味を持ったことが、この仕事に入ったきっかけです。最初から「業務自動化を専門にしよう」と決めていたわけではありません。</p>
        <p>仕事を続ける中で特に面白いと感じるようになったのが、毎日・毎月人が繰り返していた作業が、仕組みを作ることで一気に楽になる瞬間でした。<strong>手作業だったものが仕組みで自動化</strong>され、今までそこに使っていた時間を別の仕事へ回せるようになる。そういう変化を見るのが、今も開発を続ける大きな理由です。</p>
        <p>だから、技術的に難しいものを作ること自体よりも、実際の仕事がどう変わるかを重視しています。</p>
        <div class="about-origin-note">
          <span>まず確認すること</span>
          <strong>「何を一番改善したいか」から聞きます。</strong>
        </div>
      </div>
    </div>
  </section>

  <section class="section about-section-bordered">
    <div class="container">
      <p class="eyebrow">経験の広がり</p>
      <h2 class="section-title">現場の小さな改善から、<br />Web・API連携まで。</h2>
      <p class="section-lead">使う技術を先に決めるのではなく、扱う業務の課題に合わせて必要な手段を増やしてきました。</p>
      <div class="about-timeline">
        {experienceSteps.map(([no, title, copy]) => (
          <article class="about-timeline-item">
            <span class="about-timeline-no">{no}</span>
            <div><h3>{title}</h3><p>{copy}</p></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section about-belief-section">
    <div class="container about-belief-grid">
      <div>
        <p class="eyebrow">開発で一番避けたいこと</p>
        <h2 class="section-title">機能が多いことより、ちゃんと使えること。</h2>
      </div>
      <div class="about-belief-copy">
        <p>あまり好きではないのが、機能だけたくさん入っていて、実際には使いづらいツールです。</p>
        <p>できることが増えても、「どこを押せばいいか分からない」「処理が終わったのか分からない」「結局、元のExcelの方が早い」となってしまえば、現場にとっては改善になりません。</p>
        <p>そのため、相談を受けたときは機能一覧から考えるのではなく、<strong>何を一番改善したいか</strong>を先に確認します。最初は小さくても、迷わず使えて、効果が分かるものから作る方が長く残ると考えています。</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">よく扱う業務課題</p>
      <h2 class="section-title">「これを毎回やるのが面倒」から、<br />改善の入口を探します。</h2>
      <div class="about-problem-grid">
        {painPoints.map(([title, copy]) => (
          <article class="about-problem-card">
            <h3>{title}</h3>
            <p>{copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section about-strength-section">
    <div class="container about-strength-grid">
      <div>
        <p class="eyebrow">強み</p>
        <h2 class="section-title">仕様が決まっていなくても大丈夫です。</h2>
      </div>
      <div class="about-strength-copy">
        <p>「こういうことができたら便利」「今の管理方法を何とかしたい」くらいの段階でも問題ありません。現在の運用を見ながら、何を作るべきかを<strong>一緒に整理</strong>していきます。</p>
        <p>強みは、単にコードを書くことではなく、現在の運用を見ながら<strong>「どこを自動化し、どこを人に残すか」</strong>を整理できることです。</p>
        <p>Excelで十分ならExcelを残す。Google Workspace中心ならGASを使う。大量処理ならPython、複数人で使うならWebを検討する。技術ありきではなく、無理のない方法を柔軟に選びます。</p>
      </div>
    </div>
  </section>

  <section class="section about-section-bordered">
    <div class="container">
      <p class="eyebrow">得意な開発</p>
      <h2 class="section-title">小さく始めて、<br />実際の仕事に定着させる。</h2>
      <div class="about-specialty-grid">
        {specialties.map(([no, title, copy]) => (
          <article class="about-specialty-card">
            <span>{no}</span>
            <h3>{title}</h3>
            <p>{copy}</p>
          </article>
        ))}
      </div>
      <div class="about-not-fit">
        <span>向いていないご相談</span>
        <div>
          <strong>デザインだけを目的とした案件</strong>
          <p>画面の見やすさや操作性は大切にしますが、見た目だけを作る仕事より、データ処理や業務フローまで含めて「仕事がどう変わるか」を考える開発の方が得意です。</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">対応できること</p>
      <h2 class="section-title">技術を固定せず、<br />業務に合わせて組み合わせます。</h2>
      <div class="about-capability-grid">
        {capabilities.map(([no, title, copy]) => (
          <article class="about-capability">
            <span>{no}</span>
            <h3>{title}</h3>
            <p>{copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section about-section-bordered">
    <div class="container">
      <p class="eyebrow">こういう相談に向いています</p>
      <h2 class="section-title">まだ「依頼内容」になっていなくても、<br />困りごとから整理できます。</h2>
      <div class="about-fit-grid">
        {consultationFits.map(([title, copy]) => (
          <article class="about-fit-card">
            <span aria-hidden="true">→</span>
            <div><h3>{title}</h3><p>{copy}</p></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">仕事の進め方</p>
      <h2 class="section-title">仕様を決め切ってからではなく、<br />小さく確認しながら進める。</h2>
      <div class="about-workflow">
        {workflow.map(([no, title, copy]) => (
          <article class="about-workflow-item">
            <span>{no}</span>
            <h3>{title}</h3>
            <p>{copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section about-longterm-section">
    <div class="container about-longterm-grid">
      <div>
        <p class="eyebrow">これから増やしたい仕事</p>
        <h2 class="section-title">納品して終わりではなく、<br />使いながら良くしていく。</h2>
      </div>
      <div class="about-longterm-copy">
        <p>今後特に増やしたいのは、小規模なWebシステムを作り、その後の<strong>保守・改善</strong>まで長く関わる仕事です。</p>
        <p>システムは使い始めてから分かることが多くあります。「ここをもう少し変えたい」「人数が増えた」「この作業もつなげたい」といった変化に合わせ、必要なところを少しずつ直していく方が、最初から全部を盛り込むより現実的だと思っています。</p>
        <p>依頼する側と作る側というだけではなく、相談しながら良い形を探し、依頼者の仕事が楽になり、自分も継続して改善に関われる。そんな<strong>お互いにメリットのある関係</strong>を作れたら理想です。</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">開発で大切にしていること</p>
      <h2 class="section-title">作って終わりではなく、<br />使い続けられる状態まで考える。</h2>
      <div class="about-principle-grid">
        {principles.map(([no, title, copy]) => (
          <article class="about-principle">
            <span>{no}</span>
            <h3>{title}</h3>
            <p>{copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section about-personal-section">
    <div class="container about-personal-grid">
      <div>
        <p class="eyebrow">少しだけ個人的なこと</p>
        <h2 class="section-title">パソコン以外の時間も、<br />ちゃんとあります。</h2>
      </div>
      <div class="about-personal-card">
        <p><strong>30代の現役SE</strong>です。本業とは別に、個人でもシステム開発や業務改善の仕事をしています。</p>
        <p>仕事以外では<strong>スポーツ観戦</strong>が好きです。あとは<strong>お酒</strong>も好きなので、休みの日は試合を見ながらゆっくり飲んでいることもあります。</p>
        <p>本名や勤務先までは公開していませんが、技術だけではなく「どんな考え方で作っている人なのか」は、このサイトでなるべく伝わるようにしたいと思っています。</p>
      </div>
    </div>
  </section>

  <section class="cta-band about-cta-band">
    <div class="container cta-band-inner">
      <div class="about-cta-copy">
        <p class="eyebrow">問い合わせ</p>
        <h2>まだ何を作るか<br />決まっていなくても大丈夫です。</h2>
        <p>「こういうことをできるようにしたい」「この手作業を何とかしたい」くらいの段階からでも相談できます。</p>
      </div>
      <div class="about-cta-actions">
        <a class="btn btn-primary" href="/contact">サイトから相談する <span aria-hidden="true">→</span></a>
        <a class="btn" href="https://coconala.com/users/5379632" target="_blank" rel="noopener noreferrer">ココナラから相談する <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
</BaseLayout>