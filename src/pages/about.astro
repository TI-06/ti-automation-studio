---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/about-rework.css';

const personStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'TI AUTOMATION STUDIO 制作者',
  jobTitle: 'システムエンジニア',
  description: '現役SEとして約10年、本業で業務システム開発・改修に携わりながら、Excel・GAS・Python・Web・APIを使った業務改善・自動化にも対応しています。',
  knowsAbout: ['業務自動化', 'Excel', 'VBA', 'Google Apps Script', 'Python', 'Webシステム', 'API連携', 'AI活用'],
  url: Astro.site ? new URL('/about', Astro.site).toString() : Astro.url.toString(),
};

const capabilities = [
  ['01', 'Excel・VBA', '転記、集計、入力支援、帳票作成、既存マクロの修正など。使い慣れたファイルを残したまま改善する案件にも対応しています。'],
  ['02', 'Google Apps Script', 'スプレッドシート、Drive、Gmailなどをつなぎ、複数人で使う業務や定期処理を仕組みにします。'],
  ['03', 'Python・データ処理', 'CSV・Excelの検証、変換、集計、大量処理など、人が繰り返しているデータ作業をまとめて処理します。'],
  ['04', '社内Webツール', '入力、一覧、検索、権限、承認、帳票など、業務に必要な機能だけを持つWeb画面を作ります。'],
  ['05', 'API・外部サービス連携', '外部サービスの認証、データ取得、登録、更新など、サービス間の手作業を減らします。'],
  ['06', 'AIを使った業務支援', '分類、要約、入力補助など、AIを入れることで実際に作業が減る部分に絞って使います。'],
];

const principles = [
  ['01', '今の業務を先に確認する', '新しいシステムに合わせてもらうのではなく、現在の手順や使っているファイルを見てから作る範囲を決めます。'],
  ['02', '既存のものを無理に捨てない', 'ExcelやGoogle Workspaceで十分な部分は残し、困っているところだけを変える方法もよく使います。'],
  ['03', '利用者が迷わない画面にする', '機能数よりも、次に何をすればいいか分かること、処理中やエラーの状態が分かることを重視します。'],
  ['04', '後から直せる作りにする', '運用開始後の変更を想定し、データ構造や処理を分けて、追加改修しやすい状態を意識しています。'],
];
---
<BaseLayout
  title="制作者について"
  description="TI AUTOMATION STUDIOの制作者プロフィール。30代の現役SEとして約10年、Excel・GAS・Python・Web・APIを使った業務改善や社内ツール開発に対応しています。"
  structuredData={personStructuredData}
>
  <section class="page-hero about-page-hero">
    <div class="container reveal">
      <p class="eyebrow">制作者について</p>
      <h1>30代の現役SEです。<br />相談から開発まで直接対応しています。</h1>
      <p>本業では業務システムの開発・改修に約10年携わっています。個人でも、Excel・GAS・Python・Webを使った業務改善や社内ツールの開発を続けています。</p>
      <div class="about-hero-meta" aria-label="制作者概要">
        <span>システム開発 約10年</span>
        <span>個別開発・業務改善 約100件</span>
        <span>Excel / GAS / Python / Web / API</span>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container about-profile-grid">
      <aside class="about-profile-summary" aria-label="プロフィール概要">
        <div><span>年代</span><strong>30代</strong></div>
        <div><span>本業</span><strong>システムエンジニア</strong></div>
        <div><span>経験</span><strong>システム開発 約10年</strong></div>
        <div><span>個別対応</span><strong>開発・業務改善 約100件</strong></div>
      </aside>

      <div class="about-story">
        <p class="eyebrow">このサイトで受けている仕事</p>
        <h2 class="section-title">業務で使うExcelやスプレッドシートを、必要なところから改善しています。</h2>
        <p>相談で多いのは、転記や集計を毎月繰り返している、Excelが複雑になって触れる人が限られている、入力した内容からPDFを作りたい、複数人で使える管理画面がほしい、といった業務です。</p>
        <p>最初から「GASで作る」「Webシステムにする」と決めることはあまりありません。現在のファイルや作業手順を確認して、Excelを残すのか、GASを使うのか、PythonやWebに分けるのかを決めています。</p>
        <p>小さな修正で済むなら、その方が費用も運用負荷も抑えられます。逆に、複数人利用や権限管理が必要でExcelでは無理がある場合は、Web化を提案します。</p>
      </div>
    </div>
  </section>

  <section class="section about-section-bordered">
    <div class="container">
      <p class="eyebrow">得意なこと</p>
      <h2 class="section-title">よく対応している開発</h2>
      <div class="about-capability-grid">
        {capabilities.map(([no, title, copy]) => (
          <article class="about-capability">
            <span>{no}</span>
            <h3>{title}</h3>
            <p>{copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">仕事で気を付けていること</p>
      <h2 class="section-title">作ったあとに現場で使い続けられることを重視しています。</h2>
      <div class="about-principle-grid">
        {principles.map(([no, title, copy]) => (
          <article class="about-principle">
            <span>{no}</span>
            <h3>{title}</h3>
            <p>{copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section about-longterm-section">
    <div class="container about-longterm-grid">
      <div>
        <p class="eyebrow">保守・追加改修</p>
        <h2 class="section-title">納品後の修正や機能追加にも対応しています。</h2>
      </div>
      <div class="about-longterm-copy">
        <p>業務システムは、実際に使い始めてから「ここも変えたい」「この作業もつなげたい」と出てくることがよくあります。</p>
        <p>そのため、納品時点で全部を詰め込むより、まず必要な範囲で運用を始めて、使いながら追加していく進め方も大切にしています。</p>
        <p>今後は、小規模なWebシステムや業務ツールを作り、その後の保守・改善まで長く関われる案件を増やしていきたいと考えています。</p>
      </div>
    </div>
  </section>

  <section class="section about-personal-section">
    <div class="container about-personal-grid">
      <div>
        <p class="eyebrow">仕事以外のこと</p>
        <h2 class="section-title">少しだけ自己紹介</h2>
      </div>
      <div class="about-personal-card">
        <p>仕事以外ではスポーツ観戦が好きです。お酒も好きなので、休みの日は試合を見ながらゆっくり過ごしていることもあります。</p>
        <p>本名や勤務先は公開していませんが、依頼前に「どんな人が作るのか」が少しでも分かるように、このページでは仕事の進め方や考え方をできるだけ具体的に書いています。</p>
      </div>
    </div>
  </section>

  <section class="cta-band about-cta-band">
    <div class="container cta-band-inner">
      <div class="about-cta-copy">
        <p class="eyebrow">問い合わせ</p>
        <h2>作りたいものが決まっていなくても大丈夫です。</h2>
        <p>現在のファイルや作業内容が分かれば、どこから改善するか一緒に整理できます。</p>
      </div>
      <div class="about-cta-actions">
        <a class="btn btn-primary" href="/contact">サイトから相談する <span aria-hidden="true">→</span></a>
        <a class="btn" href="https://coconala.com/users/5379632" target="_blank" rel="noopener noreferrer">ココナラから相談する <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
</BaseLayout>
