---
import BaseLayout from '../layouts/BaseLayout.astro';
import { works } from '../data/works';
import { publishedTools } from '../data/tools';
import { solutions } from '../data/solutions';
import '../styles/portfolio.css';

const featuredWorkSlugs = ['workflow-report-system', 'construction-site-operations', 'learner-progress-management', 'ec-api-integration'];
const featuredWorks = featuredWorkSlugs
  .map((slug) => works.find((work) => work.slug === slug))
  .filter((work): work is (typeof works)[number] => Boolean(work));
const featuredSolutions = ['excel', 'gas', 'python', 'api', 'automation']
  .map((cluster) => solutions.find((solution) => solution.cluster === cluster))
  .filter((solution): solution is (typeof solutions)[number] => Boolean(solution));
const featuredTools = publishedTools.slice(0, 3);

const commonRequests = [
  ['毎月、同じ転記や集計をしている', '複数のExcel・スプレッドシート・CSVを開いて、同じ手順でまとめている作業。'],
  ['Excelが重い、複雑で触れる人が限られている', '既存の関数やVBAを残しながら、入力や処理の流れを整理したいケース。'],
  ['入力内容からPDFや帳票を作りたい', '見積書、報告書、申請書など、決まった様式への転記・出力を減らしたいケース。'],
  ['複数人で使える管理画面がほしい', 'Excelだけでは管理しづらくなった情報を、ブラウザで検索・更新できるようにしたいケース。'],
  ['外部サービスへの二重入力をなくしたい', 'APIを使って商品情報や各種データの登録・取得を自動化したいケース。'],
  ['既存のGASやVBAを直したい', 'エラー、速度低下、担当者不在などで止まっている仕組みを調査・改修したいケース。'],
];

const services = [
  ['Excel・VBA・スプレッドシート', '転記、集計、入力、ファイル作成など、日常的に繰り返している作業を減らします。', '/services/excel-automation/'],
  ['GAS・Google Workspace', 'スプレッドシート、Drive、Gmailなどをつなぎ、今あるGoogle環境を業務に合わせて使いやすくします。', '/services/gas-automation/'],
  ['Python・データ処理', 'CSVやExcelの検証、変換、集計、大量処理を自動化します。', '/services/python-data-processing/'],
  ['社内Webツール', '入力、一覧、検索、承認など、複数人で使う業務画面を必要な機能に絞って作ります。', '/services'],
  ['API・外部サービス連携', '外部サービスとの認証、データ取得、登録、更新処理をつなぎます。', '/services/api-integration/'],
  ['PDF・帳票作成', '入力済みデータから定型帳票やPDFを作成し、保存までまとめて自動化します。', '/services/pdf-document-automation/'],
];

const priceRanges = [
  ['小規模な修正', '1〜5万円程度', 'VBA・GASのエラー修正や小さな仕様変更など'],
  ['単機能の自動化', '3〜10万円程度', '転記、集計、PDF出力、CSV変換など'],
  ['業務ツール開発', '10〜30万円程度', '入力画面、一覧、検索、権限、帳票など'],
  ['Webシステム・複数連携', '個別見積', '認証、データベース、外部APIなどを含む構成'],
];

const process = [
  ['01', '相談', '困っている作業と、どうなれば楽になるかを確認します。'],
  ['02', '現状確認', '実際のファイル、入力項目、作業手順、利用人数などを確認します。'],
  ['03', '仕様・見積', '必要な機能と不要な機能を分け、作る範囲と費用を整理します。'],
  ['04', '開発', '確認できる単位で作り、途中で画面や動きを見てもらいながら進めます。'],
  ['05', 'テスト', '通常の操作だけでなく、入力ミスや例外時の動きも確認します。'],
  ['06', '納品・追加改修', '運用開始後に出てきた修正や追加要望にも対応します。'],
];

const processPhases = [
  { number: '01', name: '相談・現状確認', steps: process.slice(0, 2) },
  { number: '02', name: '設計・開発', steps: process.slice(2, 4) },
  { number: '03', name: '確認・納品', steps: process.slice(4, 6) },
];

const faqs = [
  ['仕様が決まっていなくても相談できますか？', '大丈夫です。現在使っているファイルや作業手順を見ながら、どこまで作るかを整理できます。'],
  ['既存のExcelやGASの修正だけでも依頼できますか？', '対応しています。全面的に作り直す前に、今の構成を活かせるか確認します。'],
  ['小さな修正でも依頼できますか？', '対応しています。エラー修正や単機能の追加など、小規模な依頼からでもご相談ください。'],
  ['スマートフォンで使う画面も作れますか？', '業務内容に応じて、PCとスマートフォンの両方で使いやすい画面を設計できます。'],
  ['納品後の修正や機能追加もお願いできますか？', '可能です。実際に使ってから出てきた改善点を見ながら、追加改修にも対応しています。'],
  ['何を送れば見積できますか？', '現在のファイル、手作業の流れ、利用人数、作りたいもののイメージが分かると見積しやすくなります。'],
];
---
<BaseLayout
  title="業務自動化・Excel/GAS/Python開発"
  description="Excel・GAS・Python・Web・APIを使った業務自動化・社内ツール開発。転記、集計、帳票作成、データ処理、既存VBA・GASの修正まで対応します。"
>
  <section class="hero">
    <div class="container hero-grid reveal">
      <div>
        <p class="eyebrow">業務自動化・社内ツール開発</p>
        <h1><span class="hero-line">Excelやスプレッドシートの手作業を、</span><span class="hero-line accent">業務に合う仕組みに変えます。</span></h1>
        <p class="hero-copy">転記・集計・帳票作成・データ加工・複数人での管理など、今の業務で時間がかかっている部分を確認し、Excel・GAS・Python・Webを使い分けて改善します。既存ファイルの修正から新しい業務ツールの開発まで対応しています。</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/contact">まずは無料相談 <span aria-hidden="true">→</span></a>
          <a class="btn" href="/works">開発実績を見る <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <aside class="hero-side" aria-label="相談できる内容">
        <strong>こんな段階から相談できます</strong>
        <p>「毎月同じ作業に時間がかかる」「今のExcelを直したい」「何で作ればいいか分からない」といった段階から相談できます。</p>
      </aside>
    </div>
  </section>

  <section class="section-tight">
    <div class="container metrics" aria-label="実績概要">
      <div class="metric"><span class="metric-value">約10年</span><span class="metric-label">システム開発の実務経験</span></div>
      <div class="metric"><span class="metric-value">約100件</span><span class="metric-label">個別開発・業務改善の対応実績</span></div>
      <div class="metric"><span class="metric-value">Excel〜Web</span><span class="metric-label">業務に合わせて技術を選択</span></div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">よくあるご相談</p>
      <h2 class="section-title">こうした手作業、減らせます。</h2>
      <p class="section-lead">毎月のExcel集計、入力・承認、帳票作成など、手間のかかる作業から相談できます。</p>
      <div class="request-grid">
        {commonRequests.map(([title, copy], index) => (
          <article class="request-card">
            <span class="request-card-no">{String(index + 1).padStart(2, '0')}</span>
            <h3>{title}</h3>
            <p>{copy}</p>
          </article>
        ))}
      </div>
      <div class="hero-actions">
        <a class="btn" href="/contact">今の作業について相談する <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">開発実績</p>
      <h2 class="section-title">業務で使う仕組みを、実例でご紹介します。</h2>
      <p class="section-lead">顧客名や実データは出していません。どんな作業に困っていて、どこまでシステム化したかを中心にまとめています。</p>
      <div class="card-grid">
        {featuredWorks.map((work) => (
          <a class="work-card home-work-card" href={`/works/${work.slug}`}>
            <div class="home-work-visual"><img src={work.visual} alt={work.visualAlt} width="1440" height="900" loading="lazy" decoding="async" /></div>
            <span class="card-arrow" aria-hidden="true">→</span>
            <div>
              <span class="card-kicker">{work.category}</span>
              <h3 class="card-title">{work.title}</h3>
              <p class="card-copy">{work.summary}</p>
            </div>
            <div class="tags">{work.technologies.slice(0, 4).map((tech) => <span class="tag">{tech}</span>)}</div>
          </a>
        ))}
      </div>
      <div class="hero-actions"><a class="btn" href="/works">実績一覧を見る <span aria-hidden="true">→</span></a></div>
    </div>
  </section>

  <section id="services" class="section">
    <div class="container">
      <p class="eyebrow">対応サービス</p>
      <h2 class="section-title">今の業務に合う方法を選びます。</h2>
      <p class="section-lead">Excelで十分な業務はそのまま活かし、複数人で使うならWeb化するなど、用途に合わせて構成を決めます。</p>
      <div class="service-grid">
        {services.map(([title, copy, href]) => (
          <a class="service service-linked" href={href}>
            <div><h3>{title}</h3><p>{copy}</p><span class="service-inline-link">詳しく見る →</span></div>
          </a>
        ))}
      </div>
      <div class="hero-actions">
        <a class="btn" href="/services">対応サービスをすべて見る <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">料金の目安</p>
      <h2 class="section-title">料金の目安を公開しています。</h2>
      <p class="section-lead">既存ツールの修正からWebシステムまで。内容や作業範囲によって金額は変わるため、まずは概算の参考としてご覧ください。</p>
      <div class="home-price-grid">
        {priceRanges.map(([label, price, copy]) => (
          <article class="home-price-card">
            <span>{label}</span>
            <strong>{price}</strong>
            <p>{copy}</p>
          </article>
        ))}
      </div>
      <div class="hero-actions"><a class="btn" href="/price">料金・見積の考え方を見る <span aria-hidden="true">→</span></a></div>
    </div>
  </section>

  <section id="process" class="section process-section">
    <div class="container">
      <p class="eyebrow">ご相談から納品まで</p>
      <h2 class="section-title">仕様書がなくても、今の作業を確認するところから進められます。</h2>
      <p class="process-lead">最初から全部を決め切るのではなく、実際の業務と確認用の画面を見ながら進めます。</p>
      <ol class="process-phase-grid" aria-label="ご相談から納品までの6工程">
        {processPhases.map((phase) => (
          <li class="process-phase-card">
            <div class="process-phase-head">
              <span class="process-phase-number" aria-hidden="true">{phase.number}</span>
              <div>
                <span class="process-phase-kicker">PHASE {phase.number}</span>
                <h3>{phase.name}</h3>
              </div>
              <span class="process-phase-symbol" aria-hidden="true">↗</span>
            </div>
            <ol class="process-phase-steps">
              {phase.steps.map(([no, title, copy]) => (
                <li>
                  <span class="process-step-number">{no}</span>
                  <div>
                    <h4>{title}</h4>
                    <p>{copy}</p>
                  </div>
                </li>
              ))}
            </ol>
          </li>
        ))}
      </ol>
      <div class="process-reassurance">
        <span class="process-reassurance-icon" aria-hidden="true">?</span>
        <div>
          <strong>仕様が決まっていなくても相談できます。</strong>
          <p>現在の作業やファイルを確認し、必要な範囲を一緒に整理します。</p>
        </div>
        <a href="/contact">相談する <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="section creator-intro">
    <div class="container creator-intro-grid">
      <div>
        <p class="eyebrow">制作者について</p>
        <h2 class="section-title">30代の現役SEが、相談から開発まで直接対応しています。</h2>
      </div>
      <div class="creator-intro-copy">
        <p>本業では業務システムの開発・改修に約10年携わっています。個人でも、Excel・GAS・Python・Webを使った業務改善や社内ツールの開発を続けています。</p>
        <p>作るものを先に決めるのではなく、現在のファイルや手順を確認して、「どこを変えると作業が減るか」から考える進め方をしています。</p>
        <div class="hero-actions">
          <a class="btn" href="/about">制作者について詳しく見る <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container faq-home">
      <div>
        <p class="eyebrow">よくある質問</p>
        <h2 class="section-title">依頼前によく聞かれること</h2>
      </div>
      <div class="faq-home-list">
        {faqs.map(([question, answer]) => (
          <details>
            <summary>{question}<span aria-hidden="true">＋</span></summary>
            <p>{answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">業務自動化ガイド</p>
      <h2 class="section-title">自動化の方法を、業務ごとに解説。</h2>
      <div class="card-grid">
        {featuredSolutions.map((solution) => (
          <a class="work-card" href={`/solutions/${solution.slug}/`}>
            <span class="card-arrow" aria-hidden="true">→</span>
            <div><h3 class="card-title">{solution.title}</h3><p class="card-copy">{solution.description}</p></div>
          </a>
        ))}
      </div>
      <div class="hero-actions"><a class="btn" href="/solutions">業務自動化ガイドを見る <span aria-hidden="true">→</span></a></div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">無料ツール</p>
      <h2 class="section-title">無料ツールも試せます。</h2>
      <p class="section-lead">Excel比較やデータ整理など、単発作業で使いやすいものを掲載しています。</p>
      {featuredTools.length > 0 ? (
        <div class="card-grid">
          {featuredTools.map((tool) => (
            <a class="tool-card" href={`/tools/${tool.slug}`}>
              <span class="card-arrow" aria-hidden="true">→</span>
              <div><h3 class="card-title">{tool.title}</h3><p class="card-copy">{tool.description}</p></div>
              <div class="tags">{tool.technologies.map((tech) => <span class="tag">{tech}</span>)}</div>
            </a>
          ))}
        </div>
      ) : (
        <div class="empty-state">公開できる状態まで確認したツールから順次追加します。</div>
      )}
      <div class="hero-actions"><a class="btn" href="/tools">無料ツールを見る <span aria-hidden="true">→</span></a></div>
    </div>
  </section>

  <section class="cta-band">
    <div class="container cta-band-inner">
      <div>
        <p class="eyebrow">問い合わせ</p>
        <h2>まずは、今困っている作業を教えてください。</h2>
        <p class="cta-copy">作りたいものが決まっていなくても、現在の業務から整理できます。</p>
      </div>
      <div class="cta-actions">
        <a class="btn btn-primary" href="/contact">サイトから相談する <span aria-hidden="true">→</span></a>
        <a class="btn" href="https://coconala.com/users/5379632" target="_blank" rel="noopener noreferrer">ココナラから相談する <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .request-grid, .home-price-grid {
    display: grid;
    gap: 14px;
    margin-top: 30px;
  }
  .request-grid { grid-template-columns: repeat(3, minmax(0,1fr)); }
  .home-price-grid { grid-template-columns: repeat(4, minmax(0,1fr)); }

  .request-card,
  .home-price-card {
    padding: 24px;
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    background: rgba(255,255,255,.022);
  }
  .request-card { position: relative; min-height: 190px; transition: border-color .2s ease; }
  .request-card:hover { border-color: var(--border-strong); }
  .request-card-no { display: block; color: var(--accent); font-size: .78rem; font-weight: 700; letter-spacing: .1em; margin-bottom: 20px; }
  .home-price-card { padding: 24px 20px; min-height: 185px; }
  .request-card h3 {
    margin: 0 0 10px;
    font-size: 1.05rem;
  }

  .request-card p,
  .home-price-card p,
  .cta-copy {
    margin: 0;
    color: var(--muted);
    line-height: 1.85;
  }

  .home-price-card span {
    display: block;
    color: var(--muted);
    font-size: .84rem;
  }

  .home-price-card strong {
    display: block;
    margin: 10px 0 8px;
    color: var(--accent);
    font-size: clamp(1.3rem, 3vw, 1.9rem);
  }

  .process-lead {
    max-width: 760px;
    margin: -6px 0 32px;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.9;
  }


  .process-phase-grid {
    counter-reset: none;
    list-style: none;
    margin: 34px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .process-phase-card {
    position: relative;
    min-width: 0;
    padding: clamp(22px, 2.7vw, 34px);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    background: linear-gradient(145deg, rgba(200,169,107,.065), rgba(255,255,255,.018) 55%, rgba(255,255,255,.01));
    transition: border-color .22s ease, transform .22s ease, box-shadow .22s ease;
  }

  .process-phase-card:hover {
    border-color: var(--border-strong);
    transform: translateY(-3px);
    box-shadow: var(--shadow-raised);
  }

  .process-phase-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 32px;
    width: 64px;
    height: 2px;
    background: linear-gradient(90deg, var(--accent), transparent);
  }

  .process-phase-head { display: flex; align-items: center; gap: 15px; min-width: 0; }
  .process-phase-number {
    display: grid;
    place-items: center;
    flex: 0 0 52px;
    height: 52px;
    border: 1px solid var(--border-strong);
    border-radius: 50%;
    color: var(--accent);
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -.04em;
  }
  .process-phase-kicker { display: block; color: var(--soft); font-size: .75rem; letter-spacing: .13em; font-weight: 700; }
  .process-phase-head h3 { margin: 3px 0 0; font-size: clamp(1.05rem, 1.5vw, 1.22rem); line-height: 1.4; }
  .process-phase-symbol { margin-left: auto; color: var(--accent); opacity: .7; font-size: 1.4rem; }
  .process-phase-steps {
    list-style: none;
    display: grid;
    gap: 0;
    margin: 28px 0 0;
    padding: 0;
    border-top: 1px solid var(--border);
  }
  .process-phase-steps li {
    display: grid;
    grid-template-columns: 28px minmax(0, 1fr);
    gap: 12px;
    padding: 20px 0;
    border-bottom: 1px solid var(--border);
  }
  .process-phase-steps li:last-child { padding-bottom: 6px; border-bottom: 0; }
  .process-step-number { color: var(--accent); font-size: .83rem; font-weight: 650; font-variant-numeric: tabular-nums; }
  .process-phase-steps h4 { margin: 0 0 6px; font-size: .95rem; font-weight: 650; line-height: 1.5; }
  .process-phase-steps p { margin: 0; color: var(--muted-strong); font-size: .875rem; line-height: 1.8; }
  .process-reassurance {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-top: 16px;
    padding: 22px 26px;
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    background: rgba(255,255,255,.025);
  }
  .process-reassurance-icon {
    display: grid;
    place-items: center;
    flex: 0 0 42px;
    height: 42px;
    border: 1px solid var(--border-strong);
    border-radius: 50%;
    color: var(--accent);
    font-size: 1.1rem;
    font-weight: 600;
  }
  .process-reassurance > div { min-width: 0; }
  .process-reassurance strong { display: block; font-size: .96rem; line-height: 1.5; }
  .process-reassurance p { margin: 4px 0 0; color: var(--muted); font-size: .86rem; }
  .process-reassurance a {
    margin-left: auto;
    flex: 0 0 auto;
    color: var(--accent);
    font-size: .85rem;
    font-weight: 700;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .faq-home {
    display: grid;
    grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr);
    gap: 48px;
  }

  .faq-home-list {
    display: grid;
    gap: 10px;
