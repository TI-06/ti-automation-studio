---
import BaseLayout from '../layouts/BaseLayout.astro';
import { works } from '../data/works';
import { publishedTools } from '../data/tools';
import { solutions } from '../data/solutions';

const featuredWorks = works.filter((work) => work.featured).slice(0, 4);
const featuredSolutions = solutions.slice(0, 3);
const services = [
  ['01', 'Excel・スプレッドシート業務の自動化', '手入力、転記、集計、ファイル作成など、毎日繰り返している作業を減らします。', '/services/excel-automation'],
  ['02', '社内Webツール・管理画面の開発', '業務に必要な機能だけを整理し、ブラウザから使える専用画面を構築します。', ''],
  ['03', 'GASによるGoogle Workspace活用', 'スプレッドシート、Drive、Gmailなどをつないで既存環境を業務システム化します。', '/services/gas-automation'],
  ['04', 'API・ECサービス連携', '外部サービスとのデータ連携、認証、登録・取得処理を自動化します。', '/services/api-integration'],
  ['05', 'CSV・Excel・大量データ処理', 'データの検証、変換、集計、一括処理をPythonやExcelで効率化します。', '/services/python-data-processing'],
  ['06', 'PDF・帳票・印刷物の自動生成', '入力データをもとに、定型帳票やPDFを自動で作成・保存します。', '/services/pdf-document-automation'],
  ['07', 'AIを組み込んだ業務効率化', 'AIを使うこと自体を目的にせず、実務で使える入力支援や分類・要約へ落とし込みます。', ''],
  ['08', '既存Excel・VBAの修正・改修', '動かないマクロ、遅い処理、担当者不在のVBAを調査し、必要な範囲から改善します。', '/services/vba-repair'],
  ['09', '既存GASの修正・改修', '実行エラー、時間超過、権限やAPI変更など、現在のGoogle Workspace運用を確認して修正します。', '/services/gas-repair'],
];
const process = [
  ['01', '相談', 'いま困っていることを整理します。仕様が決まっていなくても問題ありません。'],
  ['02', '現在の業務を確認', '実際の作業手順、入力データ、利用者、例外ケースを確認します。'],
  ['03', '改善案・仕様整理', '作る機能と、あえて作らない部分を整理し、無理のない構成にします。'],
  ['04', '開発', '操作性と保守性を意識しながら、小さく確認できる単位で実装します。'],
  ['05', 'テスト', '実際の業務パターンを想定し、入力・処理・エラー時の動作を確認します。'],
  ['06', '納品・改善', '運用開始後も必要に応じて調整し、使い続けられる状態へ整えます。'],
];
---
<BaseLayout
  title="業務自動化・Excel/GAS/Python開発"
  description="Excel・GAS・Python・Web・APIを活用した業務自動化・システム開発。転記、集計、帳票、データ処理、既存VBA・GASの修正まで、手作業を現場で使える仕組みに変えます。"
>
  <section class="hero">
    <div class="container hero-grid reveal">
      <div>
        <p class="eyebrow">業務改善・自動化開発</p>
        <h1>
          <span class="hero-line">Excel・GAS・Pythonで</span>
          <span class="hero-line accent">業務自動化。</span>
          <span class="hero-line">面倒な手作業を減らす。</span>
        </h1>
        <p class="hero-copy">Excel・Google Apps Script・Python・Web・APIを組み合わせ、繰り返している手作業を、現場で使える仕組みに変える開発を行っています。既存ツールの修正から新規の業務システムまで対応します。</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/works">実績を見る <span aria-hidden="true">→</span></a>
          <a class="btn" href="/contact">開発について相談する <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <aside class="hero-side" aria-label="対応方針">
        <strong>現場に合わせて設計します。</strong>
        <p>大きなシステムを最初から作るのではなく、既存のExcelやGoogle Workspaceも活かしながら、必要な部分から改善します。</p>
      </aside>
    </div>
  </section>

  <section class="section-tight">
    <div class="container metrics" aria-label="実績概要">
      <div class="metric"><span class="metric-value">約10年</span><span class="metric-label">エンジニア経験</span></div>
      <div class="metric"><span class="metric-value">約100件</span><span class="metric-label">開発・業務改善の対応実績</span></div>
      <div class="metric"><span class="metric-value">5領域+</span><span class="metric-label">Excel / GAS / Python / Web / API ほか</span></div>
    </div>
  </section>

  <section class="section creator-intro">
    <div class="container creator-intro-grid">
      <div>
        <p class="eyebrow">制作者について</p>
        <h2 class="section-title">現役SEとして約10年。<br />実務の中で使える仕組みを作っています。</h2>
      </div>
      <div class="creator-intro-copy">
        <p>本業では業務システムの開発・改修に約10年携わりながら、個別開発ではExcel・Google Apps Script・Python・Web・APIを使った業務改善・自動化に約100件対応してきました。単にシステムを作るのではなく、現在の運用を見て、どこを仕組みに任せると仕事が軽くなるかを整理することを重視しています。</p>
        <div class="creator-facts" aria-label="制作者概要">
          <div class="creator-fact"><span>本業経験</span><strong>システム開発 約10年</strong></div>
          <div class="creator-fact"><span>個別開発</span><strong>開発・業務改善 約100件</strong></div>
          <div class="creator-fact"><span>主な領域</span><strong>Excel / GAS / Python / Web / API</strong></div>
        </div>
        <div class="hero-actions">
          <a class="btn" href="/about">経歴・得意分野を詳しく見る <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <section id="services" class="section">
    <div class="container">
      <p class="eyebrow">できること</p>
      <h2 class="section-title">技術ではなく、<br />解決したい業務から考えます。</h2>
      <p class="section-lead">「何を使えばいいか分からない」という段階でも大丈夫です。現在の運用を確認し、必要な技術をこちらで組み合わせます。</p>
      <div class="service-grid">
        {services.map(([no, title, copy, href]) => (
          href ? (
            <a class="service service-linked" href={href}>
              <span class="service-no">{no}</span>
              <div><h3>{title}</h3><p>{copy}</p><span class="service-inline-link">詳しく見る →</span></div>
            </a>
          ) : (
            <article class="service">
              <span class="service-no">{no}</span>
              <div><h3>{title}</h3><p>{copy}</p></div>
            </article>
          )
        ))}
      </div>
      <div class="hero-actions">
        <a class="btn" href="/services">対応サービスを詳しく見る <span aria-hidden="true">→</span></a>
        <a class="btn" href="/price">料金・費用の目安 <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">業務自動化のヒント</p>
      <h2 class="section-title">検索される「困りごと」から、<br />解決方法を整理する。</h2>
      <p class="section-lead">転記、複数Excelの集計、VBA修正など、実務でよくある課題ごとに方法・費用・失敗しやすいポイントをまとめています。</p>
      <div class="card-grid">
        {featuredSolutions.map((solution) => (
          <a class="work-card" href={`/solutions/${solution.slug}`}>
            <span class="card-arrow" aria-hidden="true">↗</span>
            <div><span class="card-kicker">GUIDE</span><h3 class="card-title">{solution.title}</h3><p class="card-copy">{solution.description}</p></div>
          </a>
        ))}
      </div>
      <div class="hero-actions"><a class="btn" href="/solutions">業務自動化のヒントをすべて見る <span aria-hidden="true">→</span></a></div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">開発実績</p>
      <h2 class="section-title">業務の流れそのものを、<br />少しずつ軽くする。</h2>
      <p class="section-lead">顧客名や固有データは公開せず、どのような課題をどう整理・実装したかが分かる形で紹介しています。</p>
      <div class="card-grid">
        {featuredWorks.map((work, index) => (
          <a class="work-card" href={`/works/${work.slug}`}>
            <span class="card-arrow" aria-hidden="true">↗</span>
            <div>
              <span class="card-kicker">CASE {String(index + 1).padStart(2, '0')}</span>
              <h3 class="card-title">{work.title}</h3>
              <p class="card-copy">{work.summary}</p>
            </div>
            <div class="tags">{work.technologies.slice(0, 4).map((tech) => <span class="tag">{tech}</span>)}</div>
          </a>
        ))}
      </div>
      <div class="hero-actions"><a class="btn" href="/works">すべての実績を見る <span aria-hidden="true">→</span></a></div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">公開ツール</p>
      <h2 class="section-title">作ったものを、<br />実際に触れる形へ。</h2>
      <p class="section-lead">公開して問題ないことを確認したツールだけを掲載します。顧客データや秘密情報を含むものは公開しません。</p>
      {publishedTools.length > 0 ? (
        <div class="card-grid">
          {publishedTools.map((tool) => (
            <a class="tool-card" href={`/tools/${tool.slug}`}>
              <span class="card-arrow" aria-hidden="true">↗</span>
              <div><span class="card-kicker">TOOL</span><h3 class="card-title">{tool.title}</h3><p class="card-copy">{tool.description}</p></div>
              <div class="tags">{tool.technologies.map((tech) => <span class="tag">{tech}</span>)}</div>
            </a>
          ))}
        </div>
      ) : (
        <div class="empty-state">公開ツールは現在、安全確認と公開用調整を進めています。順次追加します。</div>
      )}
      <div class="hero-actions"><a class="btn" href="/tools">公開ツールを見る <span aria-hidden="true">→</span></a></div>
    </div>
  </section>

  <section id="process" class="section process-section">
    <div class="container">
      <p class="eyebrow">開発の流れ</p>
      <h2 class="section-title">仕様が固まっていなくても、<br />相談から整理できます。</h2>
      <p class="process-lead">ご相談から納品・改善まで、業務を確認しながら一つずつ形にしていきます。</p>
      <picture class="process-visual">
        <source srcset="/images/process-flow-mobile.svg" media="(max-width: 640px)" />
        <img
          src="/images/process-flow-desktop.svg"
          alt="相談から納品・改善までの開発フロー"
          loading="lazy"
          decoding="async"
          width="1440"
          height="520"
        />
      </picture>
      <ol class="process-accessible">
        {process.map(([no, title, copy]) => (
          <li><strong>{no} {title}</strong><span>{copy}</span></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="cta-band">
    <div class="container cta-band-inner">
      <div><p class="eyebrow">問い合わせ</p><h2>その手作業、<br />仕組みにできるかもしれません。</h2></div>
      <div class="cta-actions">
        <a class="btn btn-primary" href="/contact">サイトから相談する <span aria-hidden="true">→</span></a>
        <a class="btn" href="https://coconala.com/users/5379632" target="_blank" rel="noopener noreferrer">ココナラから依頼する <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .process-lead {
    max-width: 760px;
    margin: -6px 0 32px;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.9;
  }

  .process-visual {
    display: block;
    width: 100%;
    margin-top: 30px;
  }

  .process-visual img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 18px;
    box-shadow: 0 22px 70px rgb(0 0 0 / 28%);
  }

  .process-accessible {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .process-accessible li {
    display: block;
  }

  .process-accessible span {
    display: block;
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 12px;
  }

  @media (max-width: 860px) {
    .cta-actions { justify-content: flex-start; }
  }

  @media (max-width: 640px) {
    .process-lead {
      margin-bottom: 22px;
      font-size: .94rem;
    }

    .process-visual {
      margin-top: 20px;
    }

    .process-visual img {
      border-radius: 14px;
    }
  }

  @media (max-width: 560px) {
    .cta-actions { display: grid; width: 100%; }
  }
</style>