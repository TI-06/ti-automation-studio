---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { solutions } from '../../data/solutions';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: '業務自動化のヒント',
  itemListElement: solutions.map((solution, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: solution.title,
    url: Astro.site ? new URL(`/solutions/${solution.slug}`, Astro.site).toString() : `/solutions/${solution.slug}`,
  })),
};
---
<BaseLayout
  title="業務自動化のヒント｜Excel・VBA・GASの実務解説"
  description="Excel・VBA・GAS・Pythonを使った業務自動化について、転記、集計、修正依頼、PDF生成など実務でよくある課題ごとに方法と判断基準を解説します。"
  structuredData={structuredData}
>
  <section class="service-hero">
    <div class="container reveal">
      <nav class="breadcrumb" aria-label="パンくずリスト"><a href="/">トップ</a><span>／</span><span>業務自動化のヒント</span></nav>
      <p class="eyebrow">SOLUTIONS</p>
      <h1 class="section-title">業務自動化のヒント</h1>
      <p class="section-lead">「この作業はどう自動化する？」「どの方法を選べばいい？」を、Excel・VBA・GAS・Pythonなどの実務目線で整理します。方法だけでなく、向いているケース、費用の考え方、失敗しやすいポイントまでまとめています。</p>
    </div>
  </section>

  <section class="section">
    <div class="container solution-grid">
      {solutions.map((solution) => (
        <a class="solution-card" href={`/solutions/${solution.slug}`}>
          <span class="eyebrow">{solution.eyebrow}</span>
          <h2>{solution.title}</h2>
          <p>{solution.description}</p>
          <span class="solution-link">詳しく読む →</span>
        </a>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="container solution-guide">
      <div>
        <p class="eyebrow">NOT SURE?</p>
        <h2>方法が決まっていなくても大丈夫です。</h2>
      </div>
      <div>
        <p>Excelのまま直すべきか、GASやPythonへ分けるべきかは、データ量・利用人数・更新頻度で変わります。現在の作業を整理するところから相談できます。</p>
        <div class="hero-actions">
          <a class="btn" href="/tools/automation-diagnosis">無料の業務自動化診断を使う →</a>
          <a class="btn btn-primary" href="/contact">相談する →</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .solution-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
  .solution-card { display: block; padding: 30px; border: 1px solid var(--line); border-radius: 18px; background: rgba(255,255,255,.025); text-decoration: none; transition: transform .2s ease, border-color .2s ease; }
  .solution-card:hover { transform: translateY(-3px); border-color: rgba(200,169,107,.45); }
  .solution-card h2 { margin: 10px 0 12px; font-size: clamp(1.2rem, 2.2vw, 1.55rem); color: var(--text); }
  .solution-card p { margin: 0; color: var(--muted); line-height: 1.85; }
  .solution-link { display: inline-block; margin-top: 20px; color: var(--accent); font-size: .88rem; }
  .solution-guide { display: grid; grid-template-columns: .8fr 1.2fr; gap: 50px; padding: 34px; border: 1px solid var(--line); border-radius: 20px; }
  .solution-guide h2 { margin: 8px 0 0; }
  .solution-guide p { margin: 0; color: var(--muted); line-height: 1.9; }
  @media (max-width: 820px) { .solution-grid, .solution-guide { grid-template-columns: 1fr; } .solution-guide { gap: 20px; padding: 24px; } }
</style>
