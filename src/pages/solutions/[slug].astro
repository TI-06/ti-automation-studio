---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { solutions, getSolutionBySlug } from '../../data/solutions';
import { solutionDeepDives } from '../../data/solution-deep-dives';
import { works } from '../../data/works';
import { tools } from '../../data/tools';

export const prerender = true;

export function getStaticPaths() {
  return solutions.map((solution) => ({ params: { slug: solution.slug } }));
}

const { slug } = Astro.params;
const solution = getSolutionBySlug(slug ?? '');
if (!solution) return Astro.redirect('/solutions');
const deepDive = solutionDeepDives[solution.slug];

const relatedSolutions = solution.relatedSolutionSlugs
  .map((relatedSlug) => solutions.find((item) => item.slug === relatedSlug))
  .filter((item): item is NonNullable<typeof item> => Boolean(item));
const relatedWorks = solution.relatedWorkSlugs
  .map((workSlug) => works.find((work) => work.slug === workSlug))
  .filter((work): work is NonNullable<typeof work> => Boolean(work));
const relatedTools = solution.relatedToolSlugs
  .map((toolSlug) => tools.find((tool) => tool.slug === toolSlug && tool.published))
  .filter((tool): tool is NonNullable<typeof tool> => Boolean(tool));
const pageUrl = Astro.site ? new URL(`/solutions/${solution.slug}/`, Astro.site).toString() : `/solutions/${solution.slug}/`;
const articleImageUrl = Astro.site ? new URL('/og-default.svg', Astro.site).toString() : '/og-default.svg';
const logoUrl = Astro.site ? new URL('/favicon.svg', Astro.site).toString() : '/favicon.svg';

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: solution.title,
    description: solution.description,
    datePublished: solution.publishedAt,
    dateModified: deepDive ? '2026-10-14' : solution.publishedAt,
    inLanguage: 'ja-JP',
    mainEntityOfPage: pageUrl,
    image: articleImageUrl,
    author: { '@type': 'Organization', name: 'TI AUTOMATION STUDIO', url: Astro.site?.toString() ?? '/', logo: logoUrl },
    publisher: { '@type': 'Organization', name: 'TI AUTOMATION STUDIO', url: Astro.site?.toString() ?? '/', logo: logoUrl },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'トップ', item: Astro.site?.toString() ?? '/' },
      { '@type': 'ListItem', position: 2, name: '業務自動化のヒント', item: Astro.site ? new URL('/solutions', Astro.site).toString() : '/solutions' },
      { '@type': 'ListItem', position: 3, name: solution.title, item: pageUrl },
    ],
  },
];
---
<BaseLayout title={solution.seoTitle} description={solution.description} canonical={pageUrl} ogImage="/og-default.svg" structuredData={structuredData}>
  <article>
    <header class="solution-hero">
      <div class="container solution-hero-inner reveal">
        <nav class="breadcrumb" aria-label="パンくずリスト"><a href="/">トップ</a><span>／</span><a href="/solutions">業務自動化のヒント</a><span>／</span><span>{solution.title}</span></nav>
        <p class="eyebrow">{solution.eyebrow}</p>
        <h1>{solution.title}</h1>
        <p class="solution-lead">{solution.lead}</p>
        <div class="solution-answer"><span>まず結論</span><p>{solution.answer}</p></div>
        {deepDive && <p class="solution-reader-intro">{deepDive.intro}</p>}
        <nav class="solution-toc" aria-label="この記事の目次">
          <h2>この記事で分かること</h2>
          <ol>
            <li><a href="#guide-fit">自動化に向いている作業</a></li>
            <li><a href="#guide-compare">方法の選び方</a></li>
            {deepDive?.sections.map((section, index) => (
              <li><a href={`#guide-practical-${index + 1}`}>{section.heading}</a></li>
            ))}
            <li><a href="#guide-steps">実装前の確認手順</a></li>
            <li><a href="#guide-cost">費用の考え方</a></li>
            <li><a href="#guide-risks">よくある失敗</a></li>
            <li><a href="#guide-faq">よくある質問</a></li>
          </ol>
        </nav>
      </div>
    </header>

    <section class="section" id="guide-fit">
      <div class="container solution-body-grid">
        <div><p class="eyebrow">向いている作業</p><h2 class="section-title">自動化しやすい作業の特徴</h2></div>
        <ul class="solution-list">{solution.reasons.map((reason) => <li>{reason}</li>)}</ul>
      </div>
    </section>

    <section class="section" id="guide-compare">
      <div class="container">
        <p class="eyebrow">方法の比較</p>
        <h2 class="section-title">方法を比較して選ぶ</h2>
        <div class="approach-grid">
          {solution.approaches.map((approach) => (
            <article class="approach-card">
              <span>{approach.fit}</span>
              <h3>{approach.title}</h3>
              <p>{approach.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    {deepDive && (
      <div class="solution-practical-collection">
        {deepDive.sections.map((section, index) => (
          <section class="section solution-practical-section" id={`guide-practical-${index + 1}`}>
            <div class="container">
              <div class="solution-practical-heading">
                <p class="eyebrow">具体例と判断ポイント {String(index + 1).padStart(2, '0')}</p>
                <h2 class="section-title">{section.heading}</h2>
                <p>{section.lead}</p>
              </div>
              <div class="solution-practical-steps">
                {section.tasks.map((task, stepIndex) => (
                  <div class="solution-practical-step">
                    <span class="solution-practical-number">{String(stepIndex + 1).padStart(2, '0')}</span>
                    <div><h3>{task.title}</h3><p>{task.detail}</p></div>
                  </div>
                ))}
              </div>
              {section.example && (
                <div class="solution-practical-example">
                  <h3>{section.example.title}</h3>
                  <div class="solution-example-scroll">
                    <table>
                      <thead><tr>{section.example.columns.map((column) => <th scope="col">{column}</th>)}</tr></thead>
                      <tbody>{section.example.rows.map((row) => (
                        <tr>{row.map((value, columnIndex) => (
                          <td data-label={section.example!.columns[columnIndex]}>{value}</td>
                        ))}</tr>
                      ))}</tbody>
                    </table>
                  </div>
                </div>
              )}
              <div class="solution-checkpoint"><strong>確認しておきたいこと</strong><p>{section.checkpoint}</p></div>
            </div>
          </section>
        ))}
        {deepDive.sources.length > 0 && (
          <div class="container solution-official-sources">
            <h2>関連する公式資料</h2>
            <p>仕様や制限は更新されることがあります。実装前に公式情報も確認してください。</p>
            <ul>{deepDive.sources.map((source) => <li><a href={source.url} target="_blank" rel="noopener noreferrer">{source.title} ↗</a></li>)}</ul>
          </div>
        )}
      </div>
    )}

    <section class="section" id="guide-steps">
      <div class="container solution-body-grid">
        <div><p class="eyebrow">進め方</p><h2 class="section-title">実装前に整理する順番</h2></div>
        <ol class="solution-steps">
          {solution.steps.map((step, index) => <li><span>{String(index + 1).padStart(2, '0')}</span><p>{step}</p></li>)}
        </ol>
      </div>
    </section>

    <section class="section" id="guide-cost">
      <div class="container solution-note">
        <p class="eyebrow">費用について</p>
        <h2>費用を考えるときのポイント</h2>
        <p>{solution.costGuide}</p>
        <div class="hero-actions"><a class="btn" href="/price">料金・費用の目安を見る →</a></div>
      </div>
    </section>

    <section class="section" id="guide-risks">
      <div class="container solution-body-grid">
        <div><p class="eyebrow">注意点</p><h2 class="section-title">失敗しやすい設計</h2></div>
        <ul class="solution-list warning">{solution.pitfalls.map((pitfall) => <li>{pitfall}</li>)}</ul>
      </div>
    </section>

    {relatedSolutions.length > 0 && (
      <section class="section related-guides">
        <div class="container">
          <p class="eyebrow">関連ガイド</p>
          <h2 class="section-title">関連する業務自動化ガイド</h2>
          <p class="section-lead">同じ課題の周辺にある方法・費用・技術選定も続けて確認できます。</p>
          <div class="related-guide-grid">
            {relatedSolutions.map((item) => (
              <a class="related-guide-card" href={`/solutions/${item.slug}/`}>
                <span>{item.searchIntent === 'commercial' ? '依頼・費用' : '方法・解説'}</span>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
                <strong>詳しく読む →</strong>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    {relatedWorks.length > 0 && (
      <section class="section">
        <div class="container">
          <p class="eyebrow">関連する実績</p>
          <h2 class="section-title">関連する開発実績</h2>
          <div class="card-grid">
            {relatedWorks.map((work) => (
              <a class="work-card" href={`/works/${work.slug}`}>
                <span class="card-arrow" aria-hidden="true">↗</span>
                <div><span class="card-kicker">{work.category}</span><h3 class="card-title">{work.title}</h3><p class="card-copy">{work.summary}</p></div>
                <div class="tags">{work.technologies.slice(0, 4).map((tech) => <span class="tag">{tech}</span>)}</div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    {relatedTools.length > 0 && (
      <section class="section">
        <div class="container">
          <p class="eyebrow">無料ツール</p>
          <h2 class="section-title">関連する無料ツール</h2>
          <div class="card-grid">
            {relatedTools.map((tool) => (
              <a class="tool-card" href={tool.href}>
                <span class="card-arrow" aria-hidden="true">↗</span>
                <div><span class="card-kicker">{tool.shortLabel}</span><h3 class="card-title">{tool.title}</h3><p class="card-copy">{tool.description}</p></div>
                <div class="tags">{tool.technologies.slice(0, 4).map((tech) => <span class="tag">{tech}</span>)}</div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="section" id="guide-faq">
      <div class="container service-faq">
        <div><p class="eyebrow">よくある質問</p><h2 class="section-title">よくある質問</h2></div>
        <div class="service-faq-list">
          {solution.faq.map((item) => <details><summary>{item.question}<span aria-hidden="true">＋</span></summary><p>{item.answer}</p></details>)}
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container solution-service-cta">
        <div>
          <p class="eyebrow">関連サービス</p>
          <h2>自分の業務に合わせて実装したい場合</h2>
          <p>サンプルどおりに作るのではなく、現在のファイル・データ量・利用者・例外ケースに合わせて設計します。</p>
        </div>
        <div class="hero-actions">
          <a class="btn" href={`/services/${solution.relatedServiceSlug}/`}>関連サービスを見る →</a>
          <a class="btn btn-primary" href="/contact">開発について相談する →</a>
        </div>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .solution-hero { padding: 76px 0 34px; }
  .solution-hero-inner { max-width: 980px; }
  .solution-hero h1 { max-width: 900px; margin: 14px 0 22px; font-size: clamp(2.25rem, 5.4vw, 4.6rem); line-height: 1.16; letter-spacing: -.03em; }
  .solution-lead { max-width: 840px; margin: 0; color: var(--muted); font-size: 1.05rem; line-height: 2; }
  .solution-answer { margin-top: 30px; padding: 24px 26px; border-left: 3px solid var(--accent); background: rgba(200,169,107,.07); }
  .solution-answer span { color: var(--accent); font-size: .78rem; letter-spacing: .12em; }
  .solution-answer p { margin: 8px 0 0; line-height: 1.9; }
  .solution-body-grid { display: grid; grid-template-columns: .8fr 1.2fr; gap: 64px; align-items: start; }
  .solution-list { margin: 0; padding: 0; list-style: none; display: grid; gap: 12px; }
  .solution-list li { padding: 17px 18px; border: 1px solid var(--line); border-radius: 12px; line-height: 1.75; }
  .solution-list.warning li::before { content: '注意  '; color: var(--accent); font-size: .78rem; }
  .approach-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; margin-top: 30px; }
  .approach-card { padding: 24px; border: 1px solid var(--line); border-radius: 16px; }
  .approach-card > span { color: var(--accent); font-size: .78rem; }
  .approach-card h3 { margin: 10px 0; }
  .approach-card p { margin: 0; color: var(--muted); line-height: 1.8; }
  .solution-steps { margin: 0; padding: 0; list-style: none; }
  .solution-steps li { display: grid; grid-template-columns: 44px 1fr; gap: 14px; padding: 18px 0; border-bottom: 1px solid var(--line); }
  .solution-steps span { color: var(--accent); font-size: .78rem; }
  .solution-steps p { margin: 0; line-height: 1.8; }
  .solution-note { padding: 32px; border: 1px solid var(--line); border-radius: 20px; background: rgba(255,255,255,.025); }
  .solution-note h2 { margin: 8px 0 12px; }
  .solution-note p, .solution-service-cta p { color: var(--muted); line-height: 1.9; }
  .related-guide-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; margin-top: 28px; }
  .related-guide-card { display: block; padding: 24px; border: 1px solid var(--line); border-radius: 16px; text-decoration: none; background: rgba(255,255,255,.02); }
  .related-guide-card > span { color: var(--accent); font-size: .76rem; }
  .related-guide-card h3 { margin: 10px 0; color: var(--text); font-size: 1.08rem; }
  .related-guide-card p { margin: 0; color: var(--muted); line-height: 1.75; font-size: .9rem; }
  .related-guide-card strong { display: inline-block; margin-top: 16px; color: var(--accent); font-size: .82rem; }
  .solution-service-cta { padding: 34px; border: 1px solid rgba(200,169,107,.35); border-radius: 20px; background: rgba(200,169,107,.07); }
  .solution-service-cta h2 { margin: 8px 0 10px; }
  @media (max-width: 900px) { .solution-body-grid, .approach-grid, .related-guide-grid { grid-template-columns: 1fr; gap: 24px; } }
  @media (max-width: 640px) { .solution-hero { padding-top: 48px; } .solution-answer, .solution-note, .solution-service-cta { padding: 22px; } }

  /* Long-form guide reading experience */
  article [id^="guide-"] { scroll-margin-top: 98px; }
  .solution-hero { padding-top: clamp(44px, 6vw, 70px); }
  .solution-hero h1 { max-width: 900px; font-size: clamp(2rem, 4.1vw, 3.6rem); line-height: 1.22; overflow-wrap: anywhere; }
  .solution-lead { max-width: 760px; line-height: 1.92; font-size: 1rem; color: var(--muted-strong); }
  .solution-answer { max-width: 840px; border-radius: var(--radius-control); }
  .solution-answer p { max-width: 75ch; }
  .solution-reader-intro { max-width: 75ch; margin: 26px 0 0; line-height: 2; color: var(--muted-strong); font-size: 1rem; }
  .solution-toc { margin-top: 34px; padding: 23px 28px; max-width: 850px; border: 1px solid var(--border); border-radius: var(--radius-card); background: rgba(255,255,255,.018); }
  .solution-toc h2 { margin: 0 0 14px; font-size: 1.08rem; }
  .solution-toc ol { margin: 0; padding: 0 0 0 21px; display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); column-gap: 32px; row-gap: 9px; }
  .solution-toc li { min-width: 0; font-size: .88rem; line-height: 1.65; }
  .solution-toc li::marker { color: var(--accent); }
  .solution-toc a { color: var(--muted-strong); text-decoration: underline; text-decoration-color: transparent; text-underline-offset: 4px; }
  .solution-toc a:hover, .solution-toc a:focus-visible { color: var(--text); text-decoration-color: var(--accent); }
  .solution-practical-section { border-top: 1px solid var(--border); }
  .solution-practical-heading { max-width: 820px; }
  .solution-practical-heading p:not(.eyebrow) { margin: 18px 0 0; color: var(--muted-strong); line-height: 1.95; font-size: 1rem; }
  .solution-practical-steps { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 0 44px; margin: 26px 0 0; border-top: 1px solid var(--border); }
  .solution-practical-step { min-width: 0; display: grid; grid-template-columns: 32px minmax(0,1fr); gap: 14px; padding: 23px 0; border-bottom: 1px solid var(--border); }
  .solution-practical-number { color: var(--accent); font-size: .86rem; font-weight: 700; }
  .solution-practical-step h3 { margin: 0 0 8px; font-size: 1.06rem; line-height: 1.5; }
  .solution-practical-step p { margin: 0; color: var(--muted-strong); font-size: .92rem; line-height: 1.9; }
  .solution-practical-example { margin-top: 28px; padding: clamp(20px,3vw,30px); border: 1px solid var(--border); border-radius: var(--radius-card); }
  .solution-practical-example h3 { margin: 0 0 18px; font-size: 1.07rem; }
  .solution-example-scroll { max-width: 100%; overflow-x: auto; }
  .solution-practical-example table { width: 100%; border-collapse: collapse; table-layout: fixed; }
  .solution-practical-example th { padding: 13px 16px; text-align: left; color: var(--accent); font-size: .86rem; background: rgba(200,169,107,.075); }
  .solution-practical-example td { padding: 14px 16px; border-top: 1px solid var(--border); font-size: .9rem; line-height: 1.8; color: var(--muted-strong); overflow-wrap: anywhere; vertical-align: top; }
  .solution-practical-example td:first-child { color: var(--text); font-weight: 650; }
  .solution-checkpoint { display: grid; grid-template-columns: 160px minmax(0,1fr); gap: 20px; margin-top: 18px; padding: 22px 26px; border-left: 2px solid var(--accent); background: rgba(200,169,107,.055); }
  .solution-checkpoint strong { color: var(--text); font-size: .9rem; }
  .solution-checkpoint p { margin: 0; font-size: .92rem; line-height: 1.85; color: var(--muted-strong); }
  .solution-official-sources { padding: 22px 0; }
  .solution-official-sources h2 { font-size: 1.12rem; margin: 0 0 8px; }
  .solution-official-sources p { margin: 0 0 12px; color: var(--muted); font-size: .88rem; }
  .solution-official-sources ul { margin: 0; padding-left: 22px; }
  .solution-official-sources li { margin: 6px 0; }
  .solution-official-sources a { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; font-size: .9rem; }
  @media (max-width: 860px) {
    .solution-practical-steps { grid-template-columns: 1fr; }
    .solution-toc ol { grid-template-columns: 1fr; }
    .solution-checkpoint { grid-template-columns: 1fr; gap: 8px; }
  }
  @media (max-width: 640px) {
    .solution-toc { padding: 20px; }
    .solution-reader-intro { font-size: .95rem; }
    .solution-practical-step { padding: 19px 0; }
    .solution-practical-example { padding: 17px; }
    .solution-practical-example table, .solution-practical-example tbody, .solution-practical-example tr, .solution-practical-example td { display: block; width: 100%; }
    .solution-practical-example thead { position: absolute; clip: rect(0 0 0 0); width: 1px; height: 1px; overflow: hidden; white-space: nowrap; }
    .solution-practical-example tr { padding: 10px 0 14px; border-bottom: 1px solid var(--border); }
    .solution-practical-example tr:last-child { border-bottom: 0; }
    .solution-practical-example td { padding: 7px 5px; border-top: 0; }
    .solution-practical-example td::before { content: attr(data-label); display: block; color: var(--soft); font-size: .78rem; margin-bottom: 3px; }
    .solution-checkpoint { padding: 19px 20px; }
  }

</style>
