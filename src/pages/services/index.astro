---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { services } from '../../data/services';

const serviceChoices = [
  {
    concern: 'Excelの転記・集計が毎月大変',
    direction: '既存Excelを活かすか、VBA・Pythonでまとめて処理するかを比較',
    slug: 'excel-automation',
  },
  {
    concern: 'スプレッドシート・メール・Driveを連携したい',
    direction: 'Google Workspaceの権限と自動実行の範囲を整理',
    slug: 'gas-automation',
  },
  {
    concern: 'CSV・Excelが大量で処理に時間がかかる',
    direction: '文字コード・欠損・重複を検証して一括処理',
    slug: 'python-data-processing',
  },
  {
    concern: 'ECや外部システムで同じ内容を二重入力している',
    direction: '利用可能なAPI・認証・データ同期の方式を確認',
    slug: 'api-integration',
  },
  {
    concern: '請求書・報告書・日報を繰り返しPDFにしている',
    direction: '帳票テンプレート・改ページ・命名・保存をまとめる',
    slug: 'pdf-document-automation',
  },
] as const;

const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: '業務改善・自動化サービス',
  itemListElement: services.map((service, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: service.title,
    url: Astro.site ? new URL(`/services/${service.slug}/`, Astro.site).toString() : `/services/${service.slug}/`,
  })),
};
---
<BaseLayout
  title="業務改善・自動化サービス"
  description="Excel・GAS・Python・API連携・PDF帳票生成など、TI AUTOMATION STUDIOが対応する業務改善・自動化サービスを、課題別に分かりやすく紹介します。"
  structuredData={itemList}
>
  <section class="page-hero services-index-hero">
    <div class="container reveal">
      <p class="eyebrow">対応サービス</p>
      <h1>対応できる業務</h1>
      <p>Excel・GAS・Python・Web・APIなどを、現在の業務に合わせて使い分けます。近い作業内容から対応範囲をご確認ください。</p>
    </div>
  </section>

  <section class="section-tight">
    <div class="container service-index-grid">
      {services.map((service, index) => (
        <a class="service-index-card" href={`/services/${service.slug}/`}>
          <div class="service-index-card-visual">
            <img src={service.visual} alt={service.visualAlt} width="1600" height="900" loading={index < 2 ? 'eager' : 'lazy'} decoding="async" />
          </div>
          <div class="service-index-card-body">
            <div class="service-index-topline">
              <span>{String(index + 1).padStart(2, '0')}</span>
              <span>{service.eyebrow}</span>
            </div>
            <h2>{service.title}</h2>
            <p>{service.description}</p>
            <span class="service-index-link">詳しく見る <span aria-hidden="true">→</span></span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="section service-choices" aria-labelledby="service-choices-heading">
    <div class="container">
      <p class="eyebrow">業務の悩みから探す</p>
      <h2 class="section-title" id="service-choices-heading">今の困りごとに近いものを選ぶ</h2>
      <p class="section-lead">技術名が分からなくても、普段の作業から対応範囲を探せます。各ページでは方法の比較や設計時の注意点も説明しています。</p>
      <div class="service-choice-list">
        {serviceChoices.map((item) => {
          const target = services.find((service) => service.slug === item.slug);
          return (
            <a href={`/services/${item.slug}/`} class="service-choice-row">
              <div>
                <h3>{item.concern}</h3>
                <p>{item.direction}</p>
              </div>
              <span class="service-choice-action">{target?.eyebrow ?? '詳しく見る'} <span aria-hidden="true">→</span></span>
            </a>
          );
        })}
      </div>
      <p class="service-choices-note">Excel・GAS・Python・Webを組み合わせる方法もあります。どれに当てはまるか迷う場合は<a href="/contact">現在の手順から相談</a>できます。</p>
    </div>
  </section>

  <section class="section">
    <div class="container service-section-grid">
      <div>
        <p class="eyebrow">方法の選び方</p>
        <h2 class="section-title">技術名ではなく、今の作業と利用人数から決めます。</h2>
      </div>
      <div class="about-body">
        <p>一人で使うExcelの転記や集計なら、既存ファイルを活かしたVBAやPythonで十分なことがあります。Google Workspaceを中心に使っている場合はGAS、複数人で同時に入力・承認する業務ならWeb画面に分けた方が運用しやすくなります。</p>
        <p>「ExcelをWeb化したい」のように方法を先に決めなくても問題ありません。現在のファイル、作業手順、利用人数、データ件数を確認し、今の運用を残す部分と仕組みにする部分を分けて提案します。</p>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container about-panel">
      <div>
        <p class="eyebrow">選び方・費用</p>
        <h2 class="section-title">依頼内容が決まっていない場合</h2>
      </div>
      <div class="about-body">
        <p>Excelのまま直すか、GASやPythonへ分けるか、Web化するかは作業内容を見て判断します。作業別の考え方は業務自動化ガイド、費用感は料金ページにまとめています。</p>
        <div class="hero-actions">
          <a class="btn" href="/solutions">業務自動化ガイドを見る →</a>
          <a class="btn" href="/price">料金・費用の目安を見る →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="container cta-band-inner">
      <div><p class="eyebrow">相談</p><h2>どの方法が合うか分からない場合も、今の作業から相談できます。</h2></div>
      <a class="btn btn-primary" href="/contact">開発について相談する →</a>
    </div>
  </section>
</BaseLayout>
