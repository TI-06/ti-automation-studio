{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ti-automation-studio",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
